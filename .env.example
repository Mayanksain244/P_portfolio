# Copy to .env.local and fill in. Never commit .env.local.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (fixed credentials). Generate hash: node scripts/hash-password.mjs "your-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AUTH_SECRET=   # 32+ random chars for signing the session cookie

# Contact mail (Gmail SMTP with an App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO=

# Local git push only (never needed on Vercel). Keep it in .env.local, never commit it.
GITHUB_TOKEN=
